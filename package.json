{
  "name": "@aimem/workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first project context manager for AI-assisted coding tools.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:daemon": "node --env-file-if-exists=.env --import ./node_modules/.pnpm/tsx@4.22.4/node_modules/tsx/dist/loader.mjs apps/daemon/src/index.ts",
    "dev:cli": "node --env-file-if-exists=.env --import ./node_modules/.pnpm/tsx@4.22.4/node_modules/tsx/dist/loader.mjs apps/cli/src/index.ts",
    "dev:mcp": "node --env-file-if-exists=.env --import ./node_modules/.pnpm/tsx@4.22.4/node_modules/tsx/dist/loader.mjs apps/mcp-server/src/index.ts",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "dev:desktop": "pnpm --filter @aimem/desktop tauri dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
