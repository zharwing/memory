{
  "name": "@zharwing/memory-semantic-graph",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proposals": {
      "types": "./dist/proposals.d.ts",
      "default": "./dist/proposals.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@zharwing/memory-core": "workspace:*",
    "@zharwing/memory-privacy": "workspace:*"
  }
}
