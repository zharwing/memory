# Local Zharwing Memory configuration.
# Copy this file to .env and replace the token/store path for your machine.

ZHARWING_MEMORY_HOST=127.0.0.1
ZHARWING_MEMORY_PORT=37841
# Use token for shared/networked daemons. For localhost-only personal use, set
# ZHARWING_MEMORY_AUTH_MODE=none and omit ZHARWING_MEMORY_AUTH_TOKEN from agent MCP configs.
ZHARWING_MEMORY_AUTH_MODE=token

# Enable the authenticated MCP daily-memory surface for Codex and other agents.
ZHARWING_MEMORY_AGENT_SURFACE=enabled

# Optional desktop-shell overrides. Canonical names win; legacy AIMEM_* names
# remain readable for compatibility with existing local installations.
ZHARWING_MEMORY_DESKTOP_AUTOSTART_DAEMON=true
# ZHARWING_MEMORY_DESKTOP_PROJECT_ROOT=<absolute-path-to-app-source>
# ZHARWING_MEMORY_DESKTOP_DAEMON_COMMAND=<custom-daemon-command>

# Private local data. This folder stores projects, sessions, docs, imports,
# context bundles, inbox proposals, and backups. Do not commit it.
ZHARWING_MEMORY_ROOT=<absolute-path-to-private-ai-memory-store>

ZHARWING_MEMORY_DAEMON_URL=http://127.0.0.1:37841
ZHARWING_MEMORY_AUTH_TOKEN=change-me-local-token

# Browser UI uses Vite env variables.
VITE_ZHARWING_MEMORY_DAEMON_URL=http://127.0.0.1:37841
VITE_ZHARWING_MEMORY_AUTH_TOKEN=change-me-local-token
