# Local AI Memory configuration.
# Copy this file to .env and replace the token/store path for your machine.

AIMEM_HOST=127.0.0.1
AIMEM_PORT=37841
# Use token for shared/networked daemons. For localhost-only personal use, set
# AIMEM_AUTH_MODE=none and omit AIMEM_AUTH_TOKEN from agent MCP configs.
AIMEM_AUTH_MODE=token

# Private local data. This folder stores projects, sessions, docs, imports,
# context bundles, inbox proposals, and backups. Do not commit it.
AIMEM_MEMORY_ROOT=<absolute-path-to-private-ai-memory-store>

AIMEM_DAEMON_URL=http://127.0.0.1:37841
AIMEM_AUTH_TOKEN=change-me-local-token

# Browser UI uses Vite env variables.
VITE_AIMEM_DAEMON_URL=http://127.0.0.1:37841
VITE_AIMEM_AUTH_TOKEN=change-me-local-token
