{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@zharwing/memory-core": ["packages/core/src/index.ts"],
      "@zharwing/memory-store": ["packages/storage/src/index.ts"],
      "@zharwing/memory-privacy": ["packages/privacy/src/index.ts"],
      "@zharwing/memory-context-engine": ["packages/context-engine/src/index.ts"],
      "@zharwing/memory-search": ["packages/search/src/index.ts"],
      "@zharwing/memory-graph": ["packages/graph/src/index.ts"],
      "@zharwing/memory-graph/rules": ["packages/graph/src/rules.ts"],
      "@zharwing/memory-graph/projection": ["packages/graph/src/projection.ts"],
      "@zharwing/memory-graph/naming": ["packages/graph/src/naming.ts"],
      "@zharwing/memory-graph/domain-projection": ["packages/graph/src/domain-projection.ts"],
      "@zharwing/memory-semantic-graph": ["packages/semantic-graph/src/index.ts"],
      "@zharwing/memory-semantic-graph/proposals": ["packages/semantic-graph/src/proposals.ts"],
      "@zharwing/memory-assistant": ["packages/assistant-runtime/src/index.ts"],
      "@zharwing/memory-api-client": ["packages/api-client/src/index.ts"],
      "@zharwing/memory-mcp": ["packages/mcp-tools/src/index.ts"],
      "@zharwing/memory-theme": ["packages/theme/src/index.ts"]
    }
  }
}
